generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  password       String?
  bio            String?
  location       String?
  website        String?
  plan           String          @default("FREE")
  accounts       Account[]
  Demo           Demo[]
  exportedVideos ExportedVideo[]
  reviews        Review[]
  sessions       Session[]
  tutorials      Tutorial[]      @relation("UserTutorials")
  videoJobs      VideoJob[]
  hubSettings    HubSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Demo {
  id            String              @id @default(uuid())
  title         String
  description   String?
  videoUrl      String
  startTime     String?
  endTime       String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  editing       Json?
  userId        String
  isPublic      Boolean             @default(false)
  publicLink    String?             @unique
  shareCount    Int                 @default(0)
  subtitles     Json?
  exportedUrl   String?
  duration      Float?
  user          User                @relation(fields: [userId], references: [id])
  tags          String[]            @default([])
  integrations  String[]            @default([])
  userRoles     String[]            @default([])
  featured      Boolean             @default(false)
  exportedVideo ExportedVideo?
  videoJobs     VideoJob[]
  views         View[]
  ctas          Cta[]
  ctaClicks     CtaClick[]
  audioClips    AudioClip[]
  overlayConfig VideoOverlayConfig?
  leads         Lead[]
  playerEvents  PlayerEvent[]
}

model Tutorial {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  slides      Slide[]
  user        User     @relation("UserTutorials", fields: [userId], references: [id], onDelete: Cascade)
}

model Slide {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  clicks      Json?
  timestamp   Int
  createdAt   DateTime @default(now())
  tutorialId  String
  tutorial    Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
}

model View {
  id              String         @id @default(cuid())
  demoId          String?
  timestamp       DateTime       @default(now())
  duration        Int?
  exportedVideoId String?
  demo            Demo?          @relation(fields: [demoId], references: [id])
  exportedVideo   ExportedVideo? @relation(fields: [exportedVideoId], references: [id])
}

model VideoJob {
  id          String   @id @default(cuid())
  userId      String
  demoId      String?
  status      String   @default("PENDING")
  progress    Int      @default(0)
  videoUrl    String
  jobData     Json
  exportedUrl String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  demo        Demo?    @relation(fields: [demoId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model ExportedVideo {
  id             String   @id @default(cuid())
  title          String
  description    String?
  exportedUrl    String
  shareableUrl   String
  sourceVideoUrl String?
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  demoId         String?  @unique
  shareCount     Int      @default(1)
  demo           Demo?    @relation(fields: [demoId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  views          View[]

  @@index([userId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Cta {
  id        String     @id @default(cuid())
  demoId    String
  label     String
  url       String
  placement String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  demo      Demo       @relation(fields: [demoId], references: [id], onDelete: Cascade)
  clicks    CtaClick[]

  @@index([demoId])
}

model CtaClick {
  id        String   @id @default(cuid())
  ctaId     String?
  demoId    String
  label     String
  pageType  String   @default("demo")
  sessionId String?
  userId    String?
  referrer  String?
  timestamp DateTime @default(now())
  cta       Cta?     @relation(fields: [ctaId], references: [id], onDelete: SetNull)
  demo      Demo     @relation(fields: [demoId], references: [id])

  @@index([demoId, timestamp])
  @@index([ctaId])
}

model HubSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  subdomain       String?  @unique
  customDomain    String?  @unique
  sslStatus       String   @default("pending") // pending, active, failed
  dnsVerification Json? // To store TXT/CNAME records for verification
  logoUrl         String?
  brandColor      String   @default("#7C5CFC")
  textColor       String   @default("#111827")
  accentColor     String   @default("#F3F0FC")
  hubTitle        String?
  hubDescription  String?
  cloudflareId    String? // Cloudflare custom hostname ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AudioClip {
  id           String      @id @default(cuid())
  demoId       String
  demo         Demo        @relation(fields: [demoId], references: [id], onDelete: Cascade)
  originalKey  String
  trimmedKey   String?
  fileName     String
  mimeType     String
  durationSec  Float?
  trimStartSec Float       @default(0)
  trimEndSec   Float?
  order        Int         @default(0)
  status       AudioStatus @default(UPLOADING)
  error        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([demoId, order])
}

enum AudioStatus {
  UPLOADING
  PROCESSING
  READY
  TRIM_PROCESSING
  FAILED
}

// ---------------------------------------------------------------------------
// OVL — Interactive Video Overlays (GitHub #302)
// ---------------------------------------------------------------------------
// Overlay config lives here rather than in Demo.editing: `editing` is the
// editor's autosaved working draft and gets wholesale-overwritten on every save,
// whereas this row is read by an unauthenticated public page on every single
// view and must be a narrow, indexed record.
//
// ON DELETE, deliberately, per model:
//   VideoOverlayConfig · Cascade — config without its demo is meaningless.
//   Lead               · Cascade — `demoId` is required, so there is no "orphan"
//                        state to fall into. Deleting a demo therefore destroys
//                        the leads it captured, which is also the right privacy
//                        default: viewer PII must never outlive the thing it was
//                        collected for. Owners export to CSV before deleting.
//   PlayerEvent        · Cascade — raw telemetry follows its demo.
//   PlayerEventDaily   · NO foreign key, by design. The rollup is anonymous
//                        aggregate counts with no PII, and it must survive the
//                        demo so historical dashboard totals do not silently
//                        rewrite themselves when an old demo is deleted.

model VideoOverlayConfig {
  id         String   @id @default(cuid())
  demoId     String   @unique
  enabled    Boolean  @default(false)
  leadGate   Json?
  branching  Json?
  scheduling Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  demo       Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
}

model Lead {
  id          String    @id @default(cuid())
  demoId      String
  name        String
  email       String
  companySize String?
  sessionId   String?
  referrer    String?
  // The exact consent string that was on screen when this viewer ticked the box.
  // Stored per lead, never looked up from config, so a later reword of the copy
  // cannot retroactively misrepresent what someone agreed to.
  consentText String?
  consentAt   DateTime?
  createdAt   DateTime  @default(now())
  demo        Demo      @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@unique([demoId, email])
  @@index([demoId, createdAt])
}

model PlayerEvent {
  id              String   @id @default(cuid())
  demoId          String?
  // No foreign key: mirrors View.exportedVideoId usage on the /share/video/[id]
  // route, and keeps an event from a deleted export from failing the insert.
  exportedVideoId String?
  sessionId       String
  name            String
  positionSec     Float?
  meta            Json?
  timestamp       DateTime @default(now())
  demo            Demo?    @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, name, timestamp])
  @@index([sessionId])
}

model PlayerEventDaily {
  id     String   @id @default(cuid())
  demoId String
  name   String
  date   DateTime @db.Date
  count  Int      @default(0)

  @@unique([demoId, name, date])
  @@index([demoId, date])
}
